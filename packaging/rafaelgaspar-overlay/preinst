#!/bin/sh
set -e

PKG=xpra-rafaelgaspar-overlay
PY_REL_PATHS="
x11/wm.py
x11/shadow/backends.py
x11/shadow/server.py
x11/server/xtest_pointer.py
platform/posix/shadow_server.py
"

find_xpra_py() {
  for d in /usr/lib/python3*/dist-packages/xpra; do
    if [ -d "$d" ]; then
      echo "$d"
      return 0
    fi
  done
  return 1
}

divert_path() {
  target="$1"
  divert="${target}.distrib"
  if [ ! -e "$target" ]; then
    return 0
  fi
  if dpkg-divert --listpackage "$target" 2>/dev/null | grep -qx "$PKG"; then
    return 0
  fi
  dpkg-divert --package "$PKG" --add --rename --divert "$divert" "$target"
}

case "$1" in
  install|upgrade)
    PY="$(find_xpra_py || true)"
    if [ -n "${PY:-}" ]; then
      for rel in $PY_REL_PATHS; do
        divert_path "${PY}/${rel}"
      done
    fi
    if [ -e /usr/share/xpra/www ]; then
      divert_path /usr/share/xpra/www
    fi
    ;;
esac

exit 0
